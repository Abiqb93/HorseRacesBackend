# Environment for the HorseRaces backend.
#
# Copy to `.env` for local development. On Railway these are set as service
# variables instead. `.env` is gitignored and must never be committed.

# --- Database (required; the server exits at boot if any is missing) ---
DB_HOST=your-instance.eu-north-1.rds.amazonaws.com
DB_USER=
DB_PASSWORD=
DB_NAME=horseprofileshub
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# --- Outbound email (optional; email is disabled when unset) ---
# A Gmail App Password, not the account password.
GMAIL_USER=
GMAIL_PASS=

# --- Server ---
PORT=8080

# BlandfordAI. Without this the site's other 199 routes are unaffected and the
# BlandfordAI page says so; with it, /api/ai/chat can answer.
# Create a key at console.anthropic.com and set it on the Railway service.
ANTHROPIC_API_KEY=

# BlandfordAI's reach beyond the platform. Unset (or "on"), it searches the web
# and reads pages when the platform's own data does not cover a question;
# "search" lets it search and cite but not open pages; "off" keeps it to the
# platform's data alone. Web search must also be allowed for the organisation
# in the Anthropic Console (it is unless an admin has switched it off); if it
# is not, BlandfordAI answers without it and /api/ai/status says why.
# AI_WEB=on

# Where the published static datasets are read from. Only set this to point at
# a preview deployment; the default is the live site.
# SITE_ORIGIN=https://www.blandfordbloodstock.tech

# Arion (arion.co.nz) pedigree reports, searched and bought from inside the
# site with the company's subscription. Set both on the Railway service, never
# in code or in the site's own variables. Unset, the site links to Arion instead.
ARION_USERNAME=
ARION_PASSWORD=
# Reports the site may buy in a day, whoever asks (each costs Arion credits).
# ARION_DAILY_LIMIT=25
# Only these platform user ids may buy reports (comma-separated); unset, any
# registered user may.
# ARION_USERS=
# Turns on GET /api/arion/diagnose, which logs in and reports the shape of
# Arion's live pages (field names, never values) for checking the client.
# ARION_DIAGNOSE=on
