# Environment for the HorseRaces backend.
#
# Copy to `.env` for local development. On Railway these are set as service
# variables instead. `.env` is gitignored and must never be committed.

# --- Database ---
#
# The three credentials are required. Without them the server still boots and
# logs a banner naming what is missing; the database-backed routes fail until
# they are set. DB_NAME is not a credential and defaults to horseprofileshub.
#
# These names are preferred, but Railway's MySQL plugin names (MYSQLHOST,
# MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE, MYSQLPORT) are accepted too, as is
# a single DATABASE_URL / MYSQL_URL, which takes precedence over all of them.
DB_HOST=your-instance.eu-north-1.rds.amazonaws.com
DB_USER=
DB_PASSWORD=
DB_NAME=horseprofileshub
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# --- France ingestion ---
# Guards POST /api/france/schema, /ingest and /reconcile. Without it those
# routes are open to anyone who can reach the service.
FRANCE_ADMIN_TOKEN=
# The schedule is off unless this is exactly "on".
FRANCE_CRON=off

# --- Outbound email (optional; email is disabled when unset) ---
# A Gmail App Password, not the account password.
GMAIL_USER=
GMAIL_PASS=

# --- Server ---
PORT=8080
